from IPython.display import HTML, display

# Updated Dashboard Code for Google Colab with DD/MM/YYYY Formatting
html_code = """
<style>
    :root {
        --dark: #2d2d2d;
        --gold: #f39c12;
        --gray: #b0b0b0;
        --success: #27ae60;
        --danger: #e74c3c;
    }

    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f2f5; padding: 20px; }
    .main-card { background: white; max-width: 1000px; margin: auto; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }

    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 15px; margin-bottom: 25px; }
    .header h2 { margin: 0; color: var(--dark); text-transform: uppercase; letter-spacing: 1px; }

    .form-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
    .field { display: flex; flex-direction: column; }
    label { font-size: 11px; font-weight: bold; color: #555; margin-bottom: 5px; text-transform: uppercase; }
    input, select { padding: 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; outline: none; transition: 0.2s; }
    input:focus { border-color: var(--gold); box-shadow: 0 0 5px rgba(243, 156, 18, 0.2); }

    .actions { display: flex; gap: 10px; margin-bottom: 30px; }
    .btn { flex: 1; padding: 14px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 14px; transition: 0.3s; }
    .btn-calc { background: var(--dark); color: var(--gold); border: 2px solid var(--gold); }
    .btn-calc:hover { background: var(--gold); color: white; }
    .btn-print { background: var(--success); color: white; }
    .btn-print:hover { background: #219150; }

    .kpi-container { display: flex; gap: 15px; margin-bottom: 30px; display: none; }
    .kpi-card { flex: 1; background: #fff9e6; padding: 20px; border-radius: 8px; text-align: center; border: 1px solid #ffeeba; }
    .kpi-card small { display: block; color: #777; font-size: 10px; text-transform: uppercase; margin-bottom: 5px; }
    .kpi-card b { font-size: 28px; color: var(--dark); }
    .kpi-card.highlight { border-top: 5px solid var(--gold); }
    .kpi-card.waste { border-top: 5px solid var(--danger); }

    .log-section h3 { font-size: 16px; color: var(--dark); border-left: 4px solid var(--gold); padding-left: 10px; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; }
    th { background: #f8f9fa; padding: 12px; text-align: left; border-bottom: 2px solid #dee2e6; color: #666; font-size: 12px; }
    td { padding: 12px; border-bottom: 1px solid #eee; font-size: 13px; }
    .txt-prod { font-weight: bold; color: var(--success); }
    .txt-dmg { font-weight: bold; color: var(--danger); }

    @media print {
        .form-grid, .actions, .header small, button { display: none !important; }
        body { background: white; padding: 0; }
        .main-card { box-shadow: none; border: none; width: 100%; max-width: 100%; padding: 0; }
        .kpi-container { display: flex !important; }
        table { font-size: 11px; }
    }
</style>

<div class="main-card">
    <div class="header">
        <div>
            <h2>Production Productivity</h2>
            <small style="color: #999;">Efficiency & Patti Damage Tracker</small>
        </div>
        <div id="displayDate" style="font-weight: bold; color: var(--gold);"></div>
    </div>

    <div class="form-grid">
        <div class="field">
            <label>Production Date</label>
            <input type="date" id="inputDate">
        </div>
        <div class="field">
            <label>Category</label>
            <select id="inputCat" onchange="loadVariants()">
                <option value="" disabled selected>Select Category</option>
                <option value="Samosas">Samosas</option>
                <option value="Spring Rolls">Spring Rolls</option>
                <option value="Cutlets">Cutlets & Snacks</option>
            </select>
        </div>
        <div class="field">
            <label>Product Variant</label>
            <select id="inputVar"><option>Select Category First</option></select>
        </div>
        <div class="field">
            <label>Units Produced (Qty)</label>
            <input type="number" id="inputQty" placeholder="e.g. 1000">
        </div>
        <div class="field">
            <label>Total Man-Hours</label>
            <input type="number" id="inputHrs" placeholder="e.g. 8">
        </div>
        <div class="field">
            <label>Patti Damage (Pcs)</label>
            <input type="number" id="inputDmg" placeholder="e.g. 15">
        </div>
    </div>

    <div class="actions">
        <button class="btn btn-calc" onclick="calculate()">PROCESS & LOG DATA</button>
        <button class="btn btn-print" onclick="window.print()">PRINT REPORT (PDF)</button>
    </div>

    <div id="kpiBox" class="kpi-container">
        <div class="kpi-card highlight">
            <small>Productivity (Pcs/8hr Day)</small>
            <b id="kpiDay">0</b>
        </div>
        <div class="kpi-card">
            <small>Efficiency (Pcs/Hr)</small>
            <b id="kpiHr">0</b>
        </div>
        <div class="kpi-card waste">
            <small>Patti Damage %</small>
            <b id="kpiWaste" style="color: var(--danger);">0%</b>
        </div>
    </div>

    <div class="log-section">
        <h3>Daily Production History</h3>
        <table>
            <thead>
                <tr>
                    <th>Date (DD/MM/YYYY)</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Pcs/Hr</th>
                    <th>Productivity (8hr)</th>
                    <th>Damage %</th>
                </tr>
            </thead>
            <tbody id="mainLog"></tbody>
        </table>
    </div>
</div>

<script>
    const products = {
        "Samosas": ["Aloo Samosa", "Onion Samosa", "Paneer Samosa", "Irani Samosa", "Corn Samosa"],
        "Spring Rolls": ["Veg Spring Roll", "Corn Roll", "Paneer Roll", "Shanghai Roll"],
        "Cutlets": ["Veg Cutlet", "Veg Fingers", "Harabara Kabab"]
    };

    // Set default date to today
    document.getElementById('inputDate').valueAsDate = new Date();

    function loadVariants() {
        const cat = document.getElementById('inputCat').value;
        const vSelect = document.getElementById('inputVar');
        vSelect.innerHTML = "";
        products[cat].forEach(p => {
            let opt = document.createElement('option');
            opt.value = opt.innerText = p;
            vSelect.appendChild(opt);
        });
    }

    function calculate() {
        const rawDate = document.getElementById('inputDate').value; // yyyy-mm-dd
        const qty = parseFloat(document.getElementById('inputQty').value);
        const hrs = parseFloat(document.getElementById('inputHrs').value);
        const dmg = parseFloat(document.getElementById('inputDmg').value) || 0;
        const variant = document.getElementById('inputVar').value;

        if (rawDate && qty > 0 && hrs > 0) {

            // --- DATE FORMATTING LOGIC ---
            const dateParts = rawDate.split('-'); // [yyyy, mm, dd]
            const formattedDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

            const pcsHr = (qty / hrs).toFixed(2);
            const pcsDay = (pcsHr * 8).toFixed(0);
            const wastePct = ((dmg / qty) * 100).toFixed(2);

            // Update KPI View
            document.getElementById('kpiBox').style.display = 'flex';
            document.getElementById('kpiHr').innerText = pcsHr;
            document.getElementById('kpiDay').innerText = pcsDay;
            document.getElementById('kpiWaste').innerText = wastePct + "%";

            // Add Row to Table
            const log = document.getElementById('mainLog');
            const newRow = `<tr>
                <td><b>${formattedDate}</b></td>
                <td>${variant}</td>
                <td>${qty}</td>
                <td>${pcsHr}</td>
                <td class="txt-prod">${pcsDay}</td>
                <td class="txt-dmg">${wastePct}%</td>
            </tr>`;
            log.innerHTML = newRow + log.innerHTML;

            // Clear inputs for next entry
            document.getElementById('inputQty').value = "";
            document.getElementById('inputDmg').value = "";
        } else {
            alert("Please fill in Date, Qty, and Man-Hours.");
        }
    }
</script>
"""

display(HTML(html_code))

